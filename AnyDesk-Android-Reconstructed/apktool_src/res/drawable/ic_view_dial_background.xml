<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_checked="true">
        <layer-list>
            <item android:left="0.0dip" android:top="@dimen/speed_dial_button_individual_category_background_padding_vertical" android:right="0.0dip" android:bottom="@dimen/speed_dial_button_individual_category_background_padding_vertical">
                <shape android:shape="oval">
                    <solid android:color="@color/button_main_fragment_color" />
                </shape>
            </item>
            <item android:gravity="bottom" android:top="@dimen/speed_dial_button_individual_category_active_line_padding_top">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorSpeedDialActiveCategoryIndicator" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="false" android:state_checked="true">
        <layer-list>
            <item android:left="0.0dip" android:top="@dimen/speed_dial_button_individual_category_background_padding_vertical" android:right="0.0dip" android:bottom="@dimen/speed_dial_button_individual_category_background_padding_vertical">
                <shape android:shape="oval">
                    <solid android:color="@color/button_main_fragment_color" />
                </shape>
            </item>
            <item android:gravity="bottom" android:top="@dimen/speed_dial_button_individual_category_active_line_padding_top">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorSpeedDialActiveCategoryIndicator" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="0.0dip" android:top="@dimen/speed_dial_button_individual_category_background_padding_vertical" android:right="0.0dip" android:bottom="@dimen/speed_dial_button_individual_category_background_padding_vertical">
                <shape android:shape="oval">
                    <solid android:color="@color/button_main_fragment_color" />
                </shape>
            </item>
            <item android:gravity="bottom" android:top="@dimen/speed_dial_button_individual_category_active_line_padding_top">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorTransparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
