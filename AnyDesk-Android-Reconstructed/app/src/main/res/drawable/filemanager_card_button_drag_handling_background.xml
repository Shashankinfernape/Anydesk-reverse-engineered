<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorTransparent" />
                </shape>
            </item>
            <item android:gravity="bottom" android:top="@dimen/file_transfer_card_active_line_padding_top">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorPrimary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true" android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorFileManagerCardButtonBackgroundFocussed" />
        </shape>
    </item>
    <item android:state_enabled="true" android:state_pressed="true">
        <ripple android:color="@color/colorRipple">
            <item android:id="@android:id/background">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorFileManagerCard" />
                </shape>
            </item>
        </ripple>
    </item>
    <item android:state_enabled="true" android:state_drag_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorFileManagerCardButtonBackgroundFocussed" />
        </shape>
    </item>
    <item android:state_enabled="true" android:state_drag_can_accept="true">
        <animation-list android:oneshot="false">
            <item android:duration="1000">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorFileManagerCardButtonBackgroundDragCanAccept" />
                </shape>
            </item>
            <item android:duration="1000">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorTransparent" />
                </shape>
            </item>
        </animation-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorTransparent" />
        </shape>
    </item>
</selector>
