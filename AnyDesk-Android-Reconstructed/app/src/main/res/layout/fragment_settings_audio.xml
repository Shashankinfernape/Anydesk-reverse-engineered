<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@id/settings_audio_scroll_view" android:background="@color/colorMainBackground" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@id/settings_audio_container" style="@style/SettingsGroupStyle">
        <LinearLayout android:id="@id/settings_group_audio_transmission" style="@style/SettingsGroupStyle">
            <TextView android:id="@id/settings_audio_title_transmission" style="@style/SettingsTitleStyle" />
            <TextView android:id="@id/settings_audio_transmission_hint" style="@style/SettingsHintStyle" />
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_audio_transmission_inactive_layout" style="@style/SettingsLineStyle">
                <TextView android:id="@id/settings_audio_transmission_inactive_description" style="@style/SettingsDescriptionHorizontalStyle" />
                <RadioButton android:id="@id/settings_audio_transmission_inactive_radiobutton" style="@style/SettingsCheckboxStyle" />
            </LinearLayout>
            <LinearLayout android:id="@id/settings_audio_transmission_output_layout" style="@style/SettingsLineStyle">
                <TextView android:id="@id/settings_audio_transmission_output_description" style="@style/SettingsDescriptionHorizontalStyle" />
                <RadioButton android:id="@id/settings_audio_transmission_output_radiobutton" style="@style/SettingsCheckboxStyle" />
            </LinearLayout>
            <LinearLayout android:id="@id/settings_audio_transmission_mic_layout" style="@style/SettingsLineStyle">
                <TextView android:id="@id/settings_audio_transmission_mic_description" style="@style/SettingsDescriptionHorizontalStyle" />
                <RadioButton android:id="@id/settings_audio_transmission_mic_radiobutton" style="@style/SettingsCheckboxStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
        </LinearLayout>
        <LinearLayout android:id="@id/settings_group_audio_output" style="@style/SettingsGroupStyle">
            <TextView android:id="@id/settings_audio_title_output" style="@style/SettingsTitleStyle" />
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_audio_output_layout" style="@style/SettingsLineStyle">
                <TextView android:id="@id/settings_audio_output_description" style="@style/SettingsDescriptionHorizontalStyle" />
                <CheckBox android:id="@id/settings_audio_output_checkbox" style="@style/SettingsCheckboxStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
