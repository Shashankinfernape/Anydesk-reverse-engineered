<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@id/settings_connection_scroll_view" android:background="@color/colorMainBackground" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@id/settings_connection_container" style="@style/SettingsGroupStyle">
        <LinearLayout android:id="@id/settings_group_connection_general" style="@style/SettingsGroupStyle">
            <TextView android:id="@id/settings_connection_title_misc" style="@style/SettingsTitleStyle" />
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_connection_listen_port" style="@style/SettingsVerticalStyle">
                <TextView android:id="@id/settings_connection_listen_port_description" style="@style/SettingsDescriptionVerticalStyle" />
                <TextView android:id="@id/settings_connection_listen_port_value" style="@style/SettingsValueVerticalStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_connection_allow_direct_layout" style="@style/SettingsLineStyle">
                <TextView android:id="@id/settings_connection_allow_direct_description" style="@style/SettingsDescriptionHorizontalStyle" />
                <CheckBox android:id="@id/settings_connection_allow_direct_checkbox" style="@style/SettingsCheckboxStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
        </LinearLayout>
        <LinearLayout android:id="@id/settings_group_connection_proxy" style="@style/SettingsGroupStyle">
            <TextView android:id="@id/settings_connection_title_proxy" style="@style/SettingsTitleStyle" />
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_connection_proxy_mode_layout" style="@style/SettingsRadioGroupStyle">
                <LinearLayout android:id="@id/settings_connection_proxy_mode_off_layout" style="@style/SettingsLineStyle">
                    <TextView android:id="@id/settings_connection_proxy_mode_off_description" style="@style/SettingsDescriptionHorizontalStyle" />
                    <RadioButton android:id="@id/settings_connection_proxy_mode_off_radiobutton" style="@style/SettingsCheckboxStyle" />
                </LinearLayout>
                <LinearLayout android:id="@id/settings_connection_proxy_mode_auto_layout" style="@style/SettingsLineStyle">
                    <TextView android:id="@id/settings_connection_proxy_mode_auto_description" style="@style/SettingsDescriptionHorizontalStyle" />
                    <RadioButton android:id="@id/settings_connection_proxy_mode_auto_radiobutton" style="@style/SettingsCheckboxStyle" />
                </LinearLayout>
                <LinearLayout android:id="@id/settings_connection_proxy_mode_manual_layout" style="@style/SettingsLineStyle">
                    <TextView android:id="@id/settings_connection_proxy_mode_manual_description" style="@style/SettingsDescriptionHorizontalStyle" />
                    <RadioButton android:id="@id/settings_connection_proxy_mode_manual_radiobutton" style="@style/SettingsCheckboxStyle" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_connection_proxy_server" style="@style/SettingsVerticalStyle">
                <TextView android:id="@id/settings_connection_proxy_server_description" style="@style/SettingsDescriptionVerticalStyle" />
                <TextView android:id="@id/settings_connection_proxy_server_value" style="@style/SettingsValueVerticalStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_connection_proxy_port" style="@style/SettingsVerticalStyle">
                <TextView android:id="@id/settings_connection_proxy_port_description" style="@style/SettingsDescriptionVerticalStyle" />
                <TextView android:id="@id/settings_connection_proxy_port_value" style="@style/SettingsValueVerticalStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_connection_proxy_auth_layout" style="@style/SettingsLineStyle">
                <TextView android:id="@id/settings_connection_proxy_auth_description" style="@style/SettingsDescriptionHorizontalStyle" />
                <CheckBox android:id="@id/settings_connection_proxy_auth_checkbox" style="@style/SettingsCheckboxStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_connection_proxy_user" style="@style/SettingsVerticalStyle">
                <TextView android:id="@id/settings_connection_proxy_user_description" style="@style/SettingsDescriptionVerticalStyle" />
                <TextView android:id="@id/settings_connection_proxy_user_value" style="@style/SettingsValueVerticalStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_connection_proxy_password" style="@style/SettingsVerticalStyle">
                <TextView android:id="@id/settings_connection_proxy_password_description" style="@style/SettingsDescriptionVerticalStyle" />
                <TextView android:id="@id/settings_connection_proxy_password_value" style="@style/SettingsValueVerticalStyle" />
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
