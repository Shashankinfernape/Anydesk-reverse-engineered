<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@id/settings_identity_scroll_view" android:background="@color/colorMainBackground" android:layout_width="fill_parent" android:layout_height="fill_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@id/settings_identity_container" style="@style/SettingsGroupStyle">
        <LinearLayout android:id="@id/settings_group_alias" style="@style/SettingsGroupStyle">
            <TextView android:id="@id/settings_identity_title_alias" style="@style/SettingsTitleStyle" />
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <FrameLayout android:focusable="false" android:clickable="false" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@id/settings_group_identity_alias" style="@style/SettingsGroupStyle">
                    <LinearLayout android:id="@id/settings_identity_alias" style="@style/SettingsVerticalStyle">
                        <TextView android:id="@id/settings_identity_alias_description" style="@style/SettingsDescriptionVerticalStyle" />
                        <TextView android:id="@id/settings_identity_alias_value" style="@style/SettingsValueVerticalStyle" />
                    </LinearLayout>
                    <FrameLayout style="@style/HorizontalDividerStyle" />
                    <LinearLayout android:id="@id/settings_identity_show_id_layout" style="@style/SettingsLineStyle">
                        <TextView android:id="@id/settings_identity_show_id_description" style="@style/SettingsDescriptionHorizontalStyle" />
                        <CheckBox android:id="@id/settings_identity_show_id_checkbox" style="@style/SettingsCheckboxStyle" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@id/settings_identity_alias_toast_overlay" android:focusable="true" android:clickable="true" android:layout_width="fill_parent" android:layout_height="fill_parent" />
            </FrameLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
        </LinearLayout>
        <LinearLayout android:id="@id/settings_group_preview" style="@style/SettingsGroupStyle">
            <TextView android:id="@id/settings_identity_title_desk_preview" style="@style/SettingsTitleStyle" />
            <FrameLayout style="@style/HorizontalDividerStyle" />
            <LinearLayout android:id="@id/settings_identity_preview_source_layout" style="@style/SettingsRadioGroupStyle">
                <LinearLayout android:id="@id/settings_identity_preview_source_wallpaper_layout" style="@style/SettingsLineStyle">
                    <TextView android:id="@id/settings_identity_preview_source_wallpaper_description" style="@style/SettingsDescriptionHorizontalStyle" />
                    <RadioButton android:id="@id/settings_identity_preview_source_wallpaper_radiobutton" style="@style/SettingsCheckboxStyle" />
                </LinearLayout>
                <LinearLayout android:id="@id/settings_identity_preview_source_none_layout" style="@style/SettingsLineStyle">
                    <TextView android:id="@id/settings_identity_preview_source_none_description" style="@style/SettingsDescriptionHorizontalStyle" />
                    <RadioButton android:id="@id/settings_identity_preview_source_none_radiobutton" style="@style/SettingsCheckboxStyle" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout style="@style/HorizontalDividerStyle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
